# Required
ADMIN_PASSWORD=pick-a-long-password
SECRET_KEY=paste-a-long-random-string
BUSINESS_NAME=Your Consulting Co.
BASE_URL=https://forms.yourdomain.com

# Where the database, uploaded forms and signed PDFs live (must be persistent storage)
DATA_DIR=./data
LINK_EXPIRY_DAYS=30

# Optional: email sending. Leave SMTP_HOST empty to use copy-the-link only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Your Consulting Co. <forms@yourdomain.com>
ADMIN_EMAIL=you@yourdomain.com
